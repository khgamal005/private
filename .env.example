NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential used by privileged application routes.
# Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Optional dedicated credential for the public registration Edge Function.
# When omitted, SUPABASE_SECRET_KEY is verified through a service-role-only RPC.
ODEIR_REGISTRATION_INGRESS_TOKEN=

# Edge Function email configuration. The sender domain must be verified.
RESEND_API_KEY=
ODEIR_REGISTRATION_FROM_EMAIL="أودير <registration@odeir.com>"
ODEIR_PUBLIC_APP_URL=https://odeir.com
