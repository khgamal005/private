NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential used by other privileged application routes.
# Manual registration activation deliberately runs through a JWT-protected
# Supabase Edge gateway and does not depend on this Hostinger variable.
# Prefer SUPABASE_SECRET_KEY. Existing deployments may instead keep the
# conventional SUPABASE_SERVICE_ROLE_KEY name; do not set both names.
# Never expose either value with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Edge-only salt for anonymous rate-limit and configuration fingerprints.
# Generate independently; do not reuse a provider or Supabase key. This value
# is an Edge secret and is not configured in Next/Hostinger.
ODEIR_REGISTRATION_RATE_SALT=

# Platform-registration email only. Never reuse tenant or training credentials.
# Use a least-privilege Resend `Sending access` key restricted to odeir.com.
ODEIR_REGISTRATION_RESEND_API_KEY=
ODEIR_REGISTRATION_FROM_EMAIL="أودير <registration@odeir.com>"
ODEIR_PUBLIC_APP_URL=https://odeir.com

# ODEIRY AI is independently disabled until the tenant/database switches,
# OPENAI_API_KEY, a server-only Supabase finalizer credential, staging
# verification, and explicit rollout are all complete. Leave keys empty now.
# Keep the OpenAI key server-only and never add a NEXT_PUBLIC_ prefix.
ODEIRY_AI_ENABLED=false
# Manager mode has a separate fail-closed gate. It remains read-only and also
# requires the tenant capability returned by the server snapshot.
ODEIRY_MANAGER_ENABLED=false
ODEIRY_AI_MODEL=gpt-5.6-luna
ODEIRY_AI_TRACING_ENABLED=false
OPENAI_API_KEY=

# Deployment attestation for the verified Resend sender domain. Record a strict
# UTC timestamp (for example 2026-08-24T16:30:00.000Z) after checking Resend/DNS,
# and refresh it at least every 30 days. The name must match the sender domain.
ODEIR_REGISTRATION_DOMAIN_VERIFIED_NAME=odeir.com
ODEIR_REGISTRATION_DOMAIN_VERIFIED_AT=

# Deterministic confirmation-link signing. Generate at least 32 random bytes.
# Keep old versions configured until the longest outstanding link has expired.
ODEIR_REGISTRATION_CONFIRMATION_KEY_VERSION=1
ODEIR_REGISTRATION_CONFIRMATION_SECRET_V1=

# Resend webhook signing secret (whsec_...). This is separate from the API key.
ODEIR_REGISTRATION_RESEND_WEBHOOK_SECRET=
