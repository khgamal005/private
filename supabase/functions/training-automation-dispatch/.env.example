META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Legacy environment fallbacks. New tenant connections are configured from
# Settings > Integrations and stored as encrypted Vault secrets.
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_JOINING_TEMPLATE=training_joining_instructions
META_WHATSAPP_REMINDER_TEMPLATE=training_session_reminder
META_WHATSAPP_LANGUAGE_CODE=ar

# Tenant/training automation only. Never use platform-registration secrets here.
RESEND_API_KEY=
RESEND_FROM=Reef Skills <training@example.com>

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me
